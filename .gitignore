runs/

# Large dataset files (keep structure, ignore data)
datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.png
datasets/**/*.gif
datasets/**/*.bmp
datasets/**/*.mp4
datasets/**/*.avi
datasets/**/*.mov

# But keep .gitkeep files
!datasets/**/.gitkeep

# Trained models (can be large)
models/*.onnx
models/*.pt
models/*.pth

