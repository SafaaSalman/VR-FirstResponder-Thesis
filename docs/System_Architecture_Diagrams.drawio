        <mxCell id="pa1" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeWidth=3;strokeColor=#37474F;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_container" target="p2_container">
