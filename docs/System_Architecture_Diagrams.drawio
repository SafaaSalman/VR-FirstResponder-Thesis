        </mxCell>
        <mxCell id="p3_s4" value="LLM writes after-action debrief" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="559" width="220" height="30" as="geometry"/>
        </mxCell>

        <!-- ── PHASE 3 output example ────────────────────────────── -->
        <mxCell id="p3_debrief_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="860" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="p3_debrief_title" value="💬 &lt;b&gt;Example Debrief Output&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#37474F;" vertex="1" parent="1">
          <mxGeometry x="55" y="645" width="300" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="p3_debrief_left" value="&lt;font style='font-size:12px'&gt;&lt;b&gt;✅ Done correctly:&lt;/b&gt;&lt;br&gt;  Drop, cover, hold&lt;br&gt;  Waited for shaking to stop&lt;br&gt;  Assessed surroundings&lt;br&gt;  Evacuated via stairs&lt;br&gt;  Reached assembly point&lt;br&gt;&lt;br&gt;&lt;b&gt;❌ Missed:&lt;/b&gt;&lt;br&gt;  Check evacuation route &lt;font color='#C62828'&gt;(critical)&lt;/font&gt;&lt;br&gt;  Conduct headcount &lt;font color='#C62828'&gt;(critical)&lt;/font&gt;&lt;br&gt;  Report status&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="55" y="675" width="250" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="p3_debrief_mid" value="&lt;font style='font-size:12px'&gt;&lt;b&gt;⚠️ Critical errors:&lt;/b&gt;&lt;br&gt;  Attempted to use elevator&lt;br&gt;&lt;br&gt;&lt;b&gt;📊 Scores:&lt;/b&gt;&lt;br&gt;  Sequence adherence: 70/100&lt;br&gt;  Critical compliance: 50/100&lt;br&gt;  Branch correctness: 80/100&lt;br&gt;  Hazard awareness: 60/100&lt;br&gt;  Completion quality: 40/100&lt;br&gt;  &lt;b&gt;Overall: 58/100&lt;/b&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="330" y="675" width="250" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="p3_debrief_right" value="&lt;font style='font-size:12px'&gt;&lt;b&gt;📝 Recommendations:&lt;/b&gt;&lt;br&gt;  1. Always verify route before&lt;br&gt;     evacuating — stairs may be&lt;br&gt;     blocked by debris&lt;br&gt;  2. Never use elevators during&lt;br&gt;     earthquake evacuation&lt;br&gt;  3. Complete headcount at&lt;br&gt;     assembly point&lt;br&gt;&lt;br&gt;&lt;b&gt;🔄 Next session:&lt;/b&gt;&lt;br&gt;  &lt;font color='#7B1FA2'&gt;&lt;i&gt;Can target weak areas:&lt;br&gt;  accountability, route checking&lt;/i&gt;&lt;/font&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="610" y="675" width="270" height="210" as="geometry"/>
        </mxCell>

