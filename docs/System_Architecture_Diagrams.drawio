        <mxCell id="p3_phase" value="PHASE 3 — DEBRIEF &amp; SCORING" style="text;html=1;strokeColor=none;fillColor=#2E7D32;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;rounded=1;" vertex="1" parent="1">
