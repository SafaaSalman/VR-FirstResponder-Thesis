        <mxCell id="p2_parse" value="&lt;b&gt;Action Parser&lt;/b&gt;&lt;br&gt;text → action IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" vertex="1" parent="1">
