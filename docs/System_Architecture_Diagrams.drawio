          <mxGeometry x="40" y="110" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="s1_num" value="①" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontColor=#1565C0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="110" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s1_label" value="&lt;b&gt;Trainee Input&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="85" y="110" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s1_content" value="&lt;font style='font-family:Consolas;font-size:11px;background:#f5f5f5;padding:4px'&gt;'I evacuate using the elevator&lt;br&gt;because it is faster'&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="280" height="60" as="geometry"/>
        </mxCell>

        <!-- ── STEP 2: Action Parser ─────────────────────────────── -->
        <mxCell id="s2_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="300" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="s2_num" value="②" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontColor=#E65100;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="280" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s2_label" value="&lt;b&gt;Action Parser&lt;/b&gt; &lt;font color='#888'&gt;(LLM)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="85" y="280" width="250" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s2_desc" value="Maps free-text → action IDs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="55" y="310" width="250" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s2_output" value="&lt;font style='font-family:Consolas;font-size:11px'&gt;{&lt;br&gt;  &quot;actions&quot;: [&lt;br&gt;    &quot;use_elevator&quot;,&lt;br&gt;    &quot;evacuate&quot;&lt;br&gt;  ]&lt;br&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="60" y="335" width="260" height="95" as="geometry"/>
        </mxCell>

        <!-- ── STEP 3: Rule Engine ───────────────────────────────── -->
        <mxCell id="s3_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="400" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="s3_num" value="③" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontColor=#C62828;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="425" y="110" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s3_label" value="&lt;b&gt;Rule Engine&lt;/b&gt; &lt;font color='#888'&gt;(Deterministic)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="465" y="110" width="320" height="30" as="geometry"/>
        </mxCell>

        <!-- Sub-step: check constraints -->
        <mxCell id="s3a" value="Check global constraints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#EF9A9A;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="180" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s3a_out" value="❌ &lt;b&gt;use_elevator&lt;/b&gt; is in&lt;br&gt;&lt;code&gt;no_elevator.forbidden_actions&lt;/code&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="630" y="145" width="185" height="40" as="geometry"/>
        </mxCell>

        <!-- Sub-step: check skipped -->
        <mxCell id="s3b" value="Check skipped steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#EF9A9A;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="195" width="180" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s3b_out" value="⚠️ &lt;b&gt;assess_surroundings&lt;/b&gt; and&lt;br&gt;&lt;b&gt;check_route&lt;/b&gt; not completed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="630" y="190" width="185" height="40" as="geometry"/>
        </mxCell>

        <!-- Output JSON -->
        <mxCell id="s3_output_label" value="Rule Engine Output:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#C62828;fontStyle=3;" vertex="1" parent="1">
          <mxGeometry x="440" y="240" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s3_output" value="&lt;font style='font-family:Consolas;font-size:10px'&gt;{&lt;br&gt;  &quot;matched_step&quot;: null,&lt;br&gt;  &quot;validity&quot;: &quot;invalid&quot;,&lt;br&gt;  &quot;violations&quot;: [&quot;forbidden_action_use_elevator&quot;],&lt;br&gt;  &quot;skipped_steps&quot;: [&quot;assess_surroundings&quot;, &quot;check_route&quot;],&lt;br&gt;  &quot;critical_error&quot;: true,&lt;br&gt;  &quot;constraint_violated&quot;: &quot;no_elevator&quot;,&lt;br&gt;  &quot;next_expected_step&quot;: &quot;assess_surroundings&quot;,&lt;br&gt;  &quot;reason&quot;: &quot;Do not use elevators during...&quot;&lt;br&gt;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C62828;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="440" y="260" width="365" height="165" as="geometry"/>
        </mxCell>

        <!-- ── STEP 4: RAG Retrieval ─────────────────────────────── -->
        <mxCell id="s4_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="300" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="s4_num" value="④" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontColor=#E65100;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="500" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s4_label" value="&lt;b&gt;RAG Retrieval&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="85" y="500" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s4_desc" value="Trigger: constraint &lt;b&gt;no_elevator&lt;/b&gt; violated" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="55" y="530" width="280" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s4_output" value="&lt;font style='font-family:Consolas;font-size:10px'&gt;&lt;b&gt;[kb_004] Elevator Prohibition&lt;/b&gt;&lt;br&gt;&quot;Elevators must never be used during&lt;br&gt;or immediately after an earthquake.&lt;br&gt;Earthquake forces can misalign elevator&lt;br&gt;shafts, damage cables, disable power...&quot;&lt;br&gt;&lt;br&gt;&lt;b&gt;[kb_005] Route Verification&lt;/b&gt;&lt;br&gt;&quot;Before beginning evacuation, verify&lt;br&gt;that your planned route is safe...&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E65100;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="50" y="555" width="280" height="135" as="geometry"/>
        </mxCell>

        <!-- ── STEP 5: LLM Response Generation ──────────────────── -->
        <mxCell id="s5_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="500" width="400" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="s5_num" value="⑤" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontColor=#2E7D32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="425" y="500" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s5_label" value="&lt;b&gt;LLM Response Generation&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="465" y="500" width="320" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s5_desc" value="Receives: rule result + RAG evidence&lt;br&gt;Task: explain the error naturally" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="435" y="530" width="350" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s5_output" value="&lt;font style='font-size:12px;color:#2E7D32'&gt;&lt;b&gt;Generated response:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#333'&gt;&lt;i&gt;'Using the elevator is not allowed in this&lt;br&gt;earthquake evacuation procedure. The correct&lt;br&gt;sequence is to assess surroundings after&lt;br&gt;shaking stops, verify a safe evacuation route,&lt;br&gt;and evacuate using stairs or another approved&lt;br&gt;exit. Elevators may become unsafe due to power&lt;br&gt;or structural failure. What would you like to&lt;br&gt;do instead?'&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="435" y="565" width="370" height="125" as="geometry"/>
        </mxCell>

        <!-- ── Arrows between steps ──────────────────────────────── -->

        <!-- 1 → 2 -->
        <mxCell id="t_a1" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeWidth=2;strokeColor=#333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1_box" target="s2_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 2 → 3 -->
        <mxCell id="t_a2" value="action IDs" style="endArrow=block;endFill=1;html=1;rounded=1;strokeWidth=2;strokeColor=#E65100;fontColor=#E65100;fontSize=11;fontStyle=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2_box" target="s3_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 3 → 4 -->
        <mxCell id="t_a3" value="step IDs +&lt;br&gt;constraint ID" style="endArrow=block;endFill=1;html=1;rounded=1;strokeWidth=2;strokeColor=#C62828;fontColor=#C62828;fontSize=10;fontStyle=1;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3_box" target="s4_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="390"/>
              <mxPoint x="400" y="560"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 4 → 5 -->
        <mxCell id="t_a4" value="protocol&lt;br&gt;paragraphs" style="endArrow=block;endFill=1;html=1;rounded=1;strokeWidth=2;strokeColor=#E65100;fontColor=#E65100;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4_box" target="s5_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 3 → 5 (rule result) -->
        <mxCell id="t_a5" value="validated result" style="endArrow=block;endFill=1;html=1;rounded=1;strokeWidth=2;strokeColor=#C62828;fontColor=#C62828;fontSize=10;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3_box" target="s5_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ── Flow order legend ─────────────────────────────────── -->
        <mxCell id="legend_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="110" width="400" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="legend_title" value="&lt;b&gt;Pipeline Order&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="1000" y="115" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="leg1" value="&lt;font color='#1565C0'&gt;&lt;b&gt;①&lt;/b&gt;&lt;/font&gt;  Trainee types free text" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="920" y="155" width="350" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="leg2" value="&lt;font color='#E65100'&gt;&lt;b&gt;②&lt;/b&gt;&lt;/font&gt;  Action Parser (LLM) extracts action IDs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="920" y="185" width="370" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="leg3" value="&lt;font color='#C62828'&gt;&lt;b&gt;③&lt;/b&gt;&lt;/font&gt;  Rule Engine checks validity (DETERMINISTIC)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="920" y="215" width="370" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="leg3a" value="      • Constraint check (forbidden actions)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="920" y="240" width="350" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg3b" value="      • Skipped step detection" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="920" y="258" width="350" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg3c" value="      • Precondition verification" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="920" y="276" width="350" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg3d" value="      • State update (if action valid)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="920" y="294" width="350" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg4" value="&lt;font color='#E65100'&gt;&lt;b&gt;④&lt;/b&gt;&lt;/font&gt;  RAG retrieves protocol evidence" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="920" y="320" width="370" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="leg4a" value="      • Only fires &lt;b&gt;after&lt;/b&gt; rule engine decides" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="920" y="345" width="350" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg4b" value="      • Fetches text for: violated constraint, skipped steps" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="920" y="363" width="370" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="leg5" value="&lt;font color='#2E7D32'&gt;&lt;b&gt;⑤&lt;/b&gt;&lt;/font&gt;  LLM generates response from rule result + RAG" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="920" y="390" width="370" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="leg5a" value="      • Natural language, in-character" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="920" y="415" width="350" height="20" as="geometry"/>
        </mxCell>

        <!-- ── What the LLM sees callout ─────────────────────────── -->
        <mxCell id="llm_sees_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="500" width="400" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="llm_sees_title" value="&lt;b&gt;What the LLM receives (prompt context)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="920" y="505" width="360" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="llm_sees" value="&lt;font style='font-size:11px'&gt;1. &lt;b&gt;Rule engine result&lt;/b&gt;: validity, violations, skipped steps&lt;br&gt;2. &lt;b&gt;RAG evidence&lt;/b&gt;: relevant protocol paragraphs&lt;br&gt;3. &lt;b&gt;Scenario state&lt;/b&gt;: current conditions&lt;br&gt;4. &lt;b&gt;Narrative context&lt;/b&gt;: location, people, environment&lt;br&gt;&lt;br&gt;&lt;font color='#C62828'&gt;&lt;b&gt;The LLM does NOT:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Decide if the action is right or wrong&lt;br&gt;• Choose the next protocol step&lt;br&gt;• Invent protocol facts&lt;br&gt;• Score the trainee&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="915" y="535" width="375" height="160" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ════════════════════════════════════════════════════════════════════
       PAGE 3 — SESSION LIFECYCLE
       Shows the full training session from start to debrief.
       ════════════════════════════════════════════════════════════════════ -->
  <diagram id="page3-session-lifecycle" name="3 – Session Lifecycle">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
