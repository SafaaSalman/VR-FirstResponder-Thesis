        <mxCell id="p2a5" value="✗" style="endArrow=block;endFill=1;html=1;rounded=1;strokeWidth=2;strokeColor=#C62828;fontColor=#C62828;fontSize=12;fontStyle=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_diamond" target="p2_invalid">
