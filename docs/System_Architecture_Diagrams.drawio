          <mxGeometry x="45" y="110" width="300" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="principle_text" value="The &lt;b&gt;Rule Engine&lt;/b&gt; (deterministic) decides protocol correctness.&lt;br&gt;The &lt;b&gt;LLM&lt;/b&gt; only communicates the result in natural language.&lt;br&gt;The &lt;b&gt;RAG&lt;/b&gt; fires &lt;b&gt;after&lt;/b&gt; the rule engine, to provide grounded evidence." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="45" y="135" width="460" height="55" as="geometry"/>
        </mxCell>

        <!-- ── KB → Protocol (dashed, offline) ──────────────────── -->
        <mxCell id="a14" value="formalized&lt;br&gt;offline" style="endArrow=block;endFill=1;html=1;rounded=1;strokeWidth=2;strokeColor=#7B1FA2;fontColor=#7B1FA2;fontSize=10;fontStyle=2;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="kb_box" target="protocol_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ════════════════════════════════════════════════════════════════════
       PAGE 2 — SINGLE TURN PIPELINE
       Shows one trainee action flowing through the system with example I/O
       ════════════════════════════════════════════════════════════════════ -->
  <diagram id="page2-single-turn" name="2 – Single Turn Pipeline">
    <mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ── Title ─────────────────────────────────────────────── -->
        <mxCell id="t_title" value="&lt;b&gt;Single-Turn Data Flow — Example: Invalid Action&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="700" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="t_sub" value="Trainee says: &lt;b&gt;&lt;i&gt;'I evacuate using the elevator because it is faster'&lt;/i&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="350" y="48" width="600" height="25" as="geometry"/>
        </mxCell>

        <!-- ── STEP 1: Trainee Input ─────────────────────────────── -->
