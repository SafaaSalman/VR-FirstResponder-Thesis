        </mxCell>
        <mxCell id="p3_s3" value="RAG retrieves evidence for missed steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" vertex="1" parent="1">
