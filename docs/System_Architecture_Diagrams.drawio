          <mxGeometry x="440" y="90" width="470" height="410" as="geometry"/>
        </mxCell>
        <mxCell id="p2_phase" value="PHASE 2 — TRAINING LOOP  (repeats per turn)" style="text;html=1;strokeColor=none;fillColor=#E65100;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="95" width="350" height="25" as="geometry"/>
        </mxCell>

        <!-- Turn flow -->
