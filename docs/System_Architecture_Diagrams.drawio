        </mxCell>
        <mxCell id="p2_hint_desc" value="Level 1: &lt;i&gt;gentle nudge&lt;/i&gt;&lt;br&gt;Level 2: &lt;i&gt;direct guidance&lt;/i&gt;&lt;br&gt;Level 3: &lt;i&gt;explicit instruction&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="470" y="430" width="250" height="55" as="geometry"/>
        </mxCell>

        <!-- Arrows inside P2 -->
        <mxCell id="p2a1" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=2;strokeColor=#333;" edge="1" parent="1" source="p2_input" target="p2_parse">
