        </mxCell>
        <mxCell id="p1_s3" value="Initialize rule engine + state tracker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#64B5F6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="240" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p1_s4" value="LLM generates scenario introduction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="250" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p1_out" value="&lt;i&gt;'A powerful earthquake strikes...&lt;br&gt;What do you do?'&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1565C0;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="285" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- ══ PHASE 2: INTERACTION LOOP ════════════════════════════ -->
